APP_ENV=development            # set to production in deployment (disables /api/docs, requires SECRET_KEY)
DATABASE_URL=sqlite:///./seo_dev.db   # production: postgresql+psycopg://user:pass@host:5432/dbname
SECRET_KEY=                    # REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECURE=false            # true behind HTTPS
CORS_ORIGINS=http://localhost:5173
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# AI: mock (default, no key, deterministic scaffolds) | openai (any OpenAI-compatible URL, incl. local Ollama/vLLM) | anthropic
AI_PROVIDER=mock
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1   # local example: http://localhost:11434/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
AI_DAILY_LIMIT_PER_USER=100
AI_RATE_PER_MINUTE=10
AUTH_RATE_PER_MINUTE=10
RATE_LIMIT_ENABLED=true
